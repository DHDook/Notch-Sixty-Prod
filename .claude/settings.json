{
  "model": "opusplan",
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun xccov *)",
      "Bash(clang *)",
      "Bash(clang++ *)",
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(ci/run_harnesses.sh *)",
      "Bash(python3 ci/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin HEAD:main)",
      "Bash(gh pr merge --admin *)"
    ]
  }
}
